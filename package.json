{
  "name": "srvh2ch11",
  "version": "1.1.0",
  "description": "A simple Node.js module that creates a server supporting both HTTP/1.1 and HTTP/2 cleartext (h2c) on the same port",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "http2",
    "h2c",
    "http2-cleartext",
    "http",
    "server",
    "dual-protocol"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Hypersequent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypersequent/srvh2ch11.git"
  },
  "bugs": {
    "url": "https://github.com/hypersequent/srvh2ch11/issues"
  },
  "homepage": "https://github.com/hypersequent/srvh2ch11#readme",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test.mjs",
    "pretest:bash": "npm run build",
    "test:bash": "bash ./test-bash-curl.sh",
    "test:multi": "bash ./multi-node-test/run-tests.sh",
    "preexample": "npm run build",
    "example": "node example.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
