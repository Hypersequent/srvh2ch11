    "http",
    "server",
    "dual-protocol"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Hypersequent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypersequent/srvh2ch11.git"
  },
  "bugs": {
    "url": "https://github.com/hypersequent/srvh2ch11/issues"
  },
  "homepage": "https://github.com/hypersequent/srvh2ch11#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bash": "./test-bash-curl.sh",
    "example": "node example.js"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
